{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv sync (API)",
      "type": "shell",
      // dev 依賴在 [dependency-groups]（PEP 735），uv sync 預設就會裝。
      // 不要加 --extra dev：那個旗標只看 [project.optional-dependencies]，會直接報錯。
      "command": "uv sync --active",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
    },
    {
      "label": "Alembic Migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/apps/api"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "dependsOn": "uv sync (API)"
    }
  ]
}
