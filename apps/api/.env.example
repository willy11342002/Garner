# Local dev: use docker-compose db
DATABASE_URL=postgresql+asyncpg://vela:vela@localhost:5432/vela

# Supabase (production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI (OpenRouter handles both Claude summaries + text-embedding-3-small)
OPENROUTER_API_KEY=sk-or-...

# Supabase Storage bucket name (create in Supabase Dashboard > Storage)
STORAGE_BUCKET=thumbnails

# Monitoring (optional)
SENTRY_DSN=
