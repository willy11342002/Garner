# Local dev: use docker-compose db
DATABASE_URL=postgresql+asyncpg://garner:garner@localhost:5432/garner

# Supabase (production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI (OpenRouter handles both Claude summaries + text-embedding-3-small)
OPENROUTER_API_KEY=sk-or-...

# Groq (Whisper transcription for YouTube videos without subtitles)
GROQ_API_KEY=gsk_...

# Whisper daily quota for free plan users (seconds, default 3600 = 60 min)
FREE_WHISPER_DAILY_SECONDS=3600

# Supabase Storage bucket name (create in Supabase Dashboard > Storage)
STORAGE_BUCKET=thumbnails

# Monitoring (optional)
SENTRY_DSN=
